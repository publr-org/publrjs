import { state, awaited, refresh, Loading } from "publr";
import { findPeople } from "../../backend/people.zig";

export function ResilientSearch() {
  let search = state("");
  const people = awaited(findPeople(search));

  function updateSearch(event: Event) {
    search = (event.currentTarget as HTMLInputElement).value;
  }

  function retry() {
    refresh(people);
  }

  return (
    <section class="lesson-people" aria-busy={people.isPending}>
      <label>Search people<input value={search} onInput={updateSearch} /></label>
      <p class="people-status">
        {people.isPending ? "Waiting for people…" : people.isError ? "Could not update people" : "Up to date"}
      </p>
      {people.isError && (
        <p role="alert">
          {(people.error as Error).message}
          <button onClick={retry}>Retry</button>
        </p>
      )}
      <Loading
        fallback={<p>Loading people…</p>}
        error={() => <p>No people loaded yet.</p>}
      >
        <ul>{people.map(person => <li key={person.id}>{person.name}</li>)}</ul>
      </Loading>
    </section>
  );
}
